datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Service {
  id          String   @id @default(uuid())
  category    String
  title       String
  iconName    String
  badge       String
  desc        String
  image       String
  isLightVip  Boolean  @default(false)
  items       String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      String   @default("AGENT")
  branch    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model Announcement {
  id        String   @id @default(cuid())
  title     String
  content   String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}